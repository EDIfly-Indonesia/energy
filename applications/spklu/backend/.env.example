# Salin menjadi .env lalu isi nilainya. JANGAN commit .env.
# Semua nilai di bawah ini placeholder, bukan kredensial asli.

# --- Database (PostgreSQL di VM ini, container energy-postgres) ---
DB_HOST_POSTGRE=127.0.0.1
DB_PORT_POSTGRE=5432
DB_USER_POSTGRE=energy_app
DB_PASSWORD_POSTGRE=isi_password_disini
DB_DATABASE_POSTGRE=spklu

# --- Keamanan aplikasi ---
# SECRET_KEY: kunci tanda tangan JWT (admin & mobile). Ganti dengan acak panjang.
SECRET_KEY=isi_random_panjang_disini
# PENGACAK: dipakai HMAC-SHA256(email) sebagai integrity key token mobile.
PENGACAK=isi_random_lain_disini
# KEY_HEADER: header bersama untuk endpoint tanpa sesi (login/registrasi/OTP).
# NILAI INI IKUT TERBUNDLE DI APK, jadi jangan dianggap rahasia.
KEY_HEADER=isi_key_header_disini

# --- Dokumentasi API ---
# 1 = Swagger aktif di /docs. Matikan (0) bila tidak ingin path terekspos.
ENABLE_DOCS=0

# --- SMTP (dipakai kirim OTP; kredensial bisa juga dari tabel t_setting) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- WhatsApp (notifikasi OTP) ---
WA_API_KEY=

# --- DOKU (pembayaran) ---
BMS_DOKU_JSESSIONID=
