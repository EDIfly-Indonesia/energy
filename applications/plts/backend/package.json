    "@fastify/swagger-ui": "^3.0.0",
    "@influxdata/influxdb-client": "^1.33.2",
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.3",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
